{
  "name": "@sonari/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@sonari/db": "workspace:*",
    "@sonari/types": "workspace:*",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@sonari/config": "workspace:*",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
